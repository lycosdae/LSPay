# Copy to .env and fill in. Never commit .env.

# PostgreSQL in production; sqlite works for local trials.
DATABASE_URL=postgresql+psycopg://lspay:CHANGE_ME@db:5432/lspay
POSTGRES_PASSWORD=CHANGE_ME

# Public HTTPS address of this server (used for cashier links).
BASE_URL=https://pay.example.com
# Secret path of the admin web; only people given the full URL can find it.
# e.g. python3 -c "import secrets; print('console-' + secrets.token_urlsafe(12))"
# Allowed characters: letters, digits, - and _. The admin web is then at
# https://pay.example.com/<ADMIN_PATH>/  and /admin returns 404.
ADMIN_PATH=
# Long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
COOKIE_SECURE=true

RECEIVE_TIMEOUT_MINUTES=30
SWEEP_INTERVAL_SECONDS=60
CALLBACK_MAX_ATTEMPTS=6

# Telegram (optional). Create a bot with @BotFather, add it to the group.
TELEGRAM_BOT_TOKEN=
# Default group chat id, e.g. -1001234567890
TELEGRAM_CHAT_ID=
# Random string; sent by Telegram on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
